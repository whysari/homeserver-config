#!/bin/bash
# ==============================================================================
#  🛸 Lenovo G50-30 Home Server Professional Status Monitor (/usr/local/bin/stats)
# ==============================================================================

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# ----------------- 1. UPTIME & SYSTEM -----------------
UPTIME=$(uptime -p 2>/dev/null | sed 's/up //')
LOAD=$(cat /proc/loadavg | awk '{print $1 ", " $2 ", " $3}')
DATE=$(date "+%Y-%m-%d %H:%M:%S")

echo -e "\n${BOLD}${BLUE}╔═══════════════════════════════════════════════════════════════════╗${NC}"
echo -e "${BOLD}${BLUE}║${NC}   ${BOLD}🛸 HOMESERVER DASHBOARD (Lenovo G50-30)${NC}       ${CYAN}${DATE}${NC}   ${BOLD}${BLUE}║${NC}"
echo -e "${BOLD}${BLUE}╚═══════════════════════════════════════════════════════════════════╝${NC}"

echo -e "\n${BOLD}⚙️  SYSTEM & HARDWARE${NC}"
printf "  • Uptime:        %s\n" "$UPTIME"
printf "  • CPU Load:      %s (1m, 5m, 15m)\n" "$LOAD"

# CPU Temp
if [ -f /sys/class/thermal/thermal_zone0/temp ]; then
    raw_temp=$(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null)
    temp=$((raw_temp / 1000))
    if [ "$temp" -lt 55 ]; then
        temp_color=$GREEN
    elif [ "$temp" -lt 70 ]; then
        temp_color=$YELLOW
    else
        temp_color=$RED
    fi
    printf "  • CPU Temp:      ${temp_color}%s°C${NC}\n" "$temp"
fi

# ----------------- 2. POWER & BATTERY ESTIMATOR -----------------
echo -e "\n${BOLD}⚡ POWER & BATTERY RUNTIME${NC}"

cap=$(cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -n 1)
stat=$(cat /sys/class/power_supply/BAT*/status 2>/dev/null | head -n 1)
pwr_raw=$(cat /sys/class/power_supply/BAT*/power_now 2>/dev/null | head -n 1)
[ -z "$pwr_raw" ] && pwr_raw=0

# Query upower first for official smoothed time-to-empty / time-to-full
upower_bat=$(upower -e 2>/dev/null | grep -m1 'BAT')
time_remaining=""
if [ -n "$upower_bat" ]; then
    time_remaining=$(upower -i "$upower_bat" 2>/dev/null | grep -E "time to" | awk -F': *' '{print $2}')
fi

# Fallback direct sysfs calculation if upower is absent
if [ -z "$time_remaining" ] && [ "$pwr_raw" -gt 0 ]; then
    enow=$(cat /sys/class/power_supply/BAT*/energy_now 2>/dev/null || cat /sys/class/power_supply/BAT*/charge_now 2>/dev/null)
    [ -z "$enow" ] && enow=0
    if [ "$enow" -gt 0 ]; then
        mins=$(( enow * 60 / pwr_raw ))
        hrs=$(( mins / 60 ))
        rem_mins=$(( mins % 60 ))
        time_remaining="${hrs}h ${rem_mins}m"
    fi
fi

if [ "$stat" = "Discharging" ]; then
    watts=$(awk "BEGIN {printf \"%.2f\", $pwr_raw/1000000}")
    [ -z "$time_remaining" ] && time_remaining="calculating..."
    printf "  • Status:        ${YELLOW}⚡ Discharging${NC} (${cap}%% remaining)\n"
    printf "  • Live Power:    ${YELLOW}%s Watts${NC}\n" "$watts"
    printf "  • Est. Runtime:  ${BOLD}${CYAN}~%s remaining${NC}\n" "$time_remaining"
elif [ "$stat" = "Charging" ]; then
    watts=$(awk "BEGIN {printf \"%.2f\", $pwr_raw/1000000}")
    [ -z "$time_remaining" ] && time_remaining="calculating..."
    printf "  • Status:        ${GREEN}🔌 Charging${NC} (${cap}%%)\n"
    printf "  • Live Power:    %s Watts\n" "$watts"
    printf "  • Time to Full:  ~%s\n" "$time_remaining"
else
    printf "  • Status:        ${GREEN}🔌 Plugged In (AC Mains)${NC} — Battery: ${cap}%% (${stat})\n"
    printf "  • Live Draw:     Float/Bypass mode (0.0W to battery)\n"
fi

# ----------------- 3. NETWORK ENDPOINTS -----------------
echo -e "\n${BOLD}🌐 NETWORK REACHABILITY${NC}"
lan_ip=$(ip -4 addr show wlp2s0 2>/dev/null | awk '/inet / {print $2}' | cut -d/ -f1)
[ -z "$lan_ip" ] && lan_ip=$(hostname -I | awk '{print $1}')
tail_ip=$(tailscale ip -4 2>/dev/null || echo "offline")

printf "  • LAN IP:        ${CYAN}%s${NC} (homeserver.local)\n" "$lan_ip"
printf "  • Tailscale IP:  ${CYAN}%s${NC} (homeserver.tail274b3b.ts.net)\n" "$tail_ip"

# ----------------- 4. MEMORY & STORAGE -----------------
echo -e "\n${BOLD}💾 STORAGE & MEMORY${NC}"
# Disk
df -h / | awk 'NR==2 {printf "  • Disk (/):      %s used / %s total (%s full, %s free)\n", $3, $2, $5, $4}'

# RAM
ram_total=$(free -h | awk '/Mem:/ {print $2}')
ram_used=$(free -h | awk '/Mem:/ {print $3}')
ram_avail=$(free -h | awk '/Mem:/ {print $7}')
printf "  • RAM:           %s used / %s total (${GREEN}%s available${NC})\n" "$ram_used" "$ram_total" "$ram_avail"

# Swap / ZRAM
swap_total=$(free -h | awk '/Swap:/ {print $2}')
swap_used=$(free -h | awk '/Swap:/ {print $3}')
if [ "$swap_total" != "0B" ] && [ -n "$swap_total" ]; then
    printf "  • Swap/ZRAM:     %s used / %s total\n" "$swap_used" "$swap_total"
fi

# ----------------- 5. DOCKER CONTAINERS -----------------
echo -e "\n${BOLD}📦 ACTIVE SERVICES${NC}"
if docker stats --no-stream &>/dev/null; then
    docker stats --no-stream --format "table   {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.MemPerc}}"
else
    sudo docker stats --no-stream --format "table   {{.Name}}\t{{.CPUPerc}}\t{{.MemUsage}}\t{{.MemPerc}}"
fi
echo ""
